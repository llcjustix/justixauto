+/** Admit only cabinets available to this session; preserve permitted URLs. */
+function CabinetGate({ children, kinds }: { children: ReactNode; kinds: Company['kind'][] | undefined }) {
+  const s = useSession();
+  const admin = [
+    'platform.directory.read', 'platform.catalog.manage', 'platform.users.manage',
+    'platform.roles.manage', 'platform.audit.read',
+  ].some((permission) => s.can(permission));
+  const available = kinds
+    ? !!(s.company && kinds.includes(s.company.kind)) || s.view.accessibleCompanies.some((c) => kinds.includes(c.kind))
+    : admin;
+  const destinations = admin
+    ? [{ url: '/admin/', label: 'Администрирование' }]
+    : [
+        ...(s.view.accessibleCompanies.some((c) => c.kind === 'seller')
+          ? [{ url: '/', label: 'Реализация' }] : []),
+        ...(s.view.accessibleCompanies.some((c) => c.kind === 'bank' || c.kind === 'mfo')
+          ? [{ url: '/finance/', label: 'Финансирование' }] : []),
+        ...(s.view.accessibleCompanies.some((c) => c.kind === 'insurance')
+          ? [{ url: '/insurance/', label: 'Страхование' }] : []),
+      ];
+  const activeHome = s.company
+    ? s.company.kind === 'seller' ? '/' : s.company.kind === 'insurance' ? '/insurance/' : '/finance/'
+    : undefined;
+  const destination = !available
+    ? destinations.find((item) => item.url === activeHome)?.url
+      ?? (destinations.length === 1 ? destinations[0]!.url : undefined)
+    : undefined;
+  useEffect(() => {
+    if (destination) window.location.replace(destination);
+  }, [destination]);
+  if (available) return <CompanyGate kinds={kinds}>{children}</CompanyGate>;
+  if (destination) return <Centered><p>Переход в кабинет…</p></Centered>;
+  if (destinations.length > 1) {
+    return (
+      <Centered>
+        <Card title="Выберите кабинет">
+          <div className={css.stack}>
+            {destinations.map((item) => (
+              <Button key={item.url} onClick={() => window.location.replace(item.url)}>{item.label}</Button>
+            ))}
+          </div>
+        </Card>
+      </Centered>
+    );
+  }
+  return (
+    <Centered>
+      <Card title="Нет доступа">
+        <p>У вашей учётной записи нет доступа к кабинетам.</p>
+        <Button onClick={() => void s.logout()}>Выйти</Button>
+      </Card>
+    </Centered>
+  );
+}
