{
  "name": "justixauto-web",
  "version": "0.1.0",
  "private": true,
  "description": "JustixAuto frontend: four React apps, shared packages and mock tooling",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "mocks:build": "node tools/build-mocks.mjs",
    "mocks:verify": "node tools/verify-mocks.mjs",
    "mocks:test": "node tools/test-mocks.mjs",
    "mocks:serve": "node tools/serve-mocks.mjs",
    "typecheck": "npm run typecheck:config && npm run typecheck --workspaces",
    "typecheck:config": "tsc --noEmit --strict --module esnext --moduleResolution bundler --target es2022 --types node vitest.workspace.ts",
    "lint": "eslint --config eslint.config.js . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test:unit": "vitest run --config vitest.workspace.ts --configLoader runner",
    "test:unit:coverage": "npm run test:unit -- --coverage",
    "build": "npm run build --workspaces",
    "build:apps": "npm run build --workspace apps"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "clean-css": "5.3.3",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "html-minifier-terser": "7.2.0",
    "knip": "6.38.0",
    "prettier": "3.9.9",
    "terser": "5.44.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  }
}
