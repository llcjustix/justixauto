# Local development only. `make env` copies it to .env (git-ignored); adjust
# there. cmd/api, cmd/migrate and the Vite apps read .env at start-up; values
# already set in the environment win. Deployments have no .env.
# PostgreSQL in Docker (deploy/local/compose.yaml); a different port or
# password must also be changed in DATABASE_URL.
POSTGRES_PORT=55432
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://justixauto:change-me-local-only@127.0.0.1:55432/justixauto?sslmode=disable
# The Vite apps proxy /api here.
HTTP_ADDR=127.0.0.1:8080
# Plain-HTTP local development only; keep true (default) everywhere else.
COOKIE_SECURE=false
# Extra origins allowed to send state-changing requests: the Vite dev servers
# (realization 5191, financing 5192, insurance 5193, admin 5194).
ALLOWED_ORIGINS=http://127.0.0.1:5191,http://localhost:5191,http://127.0.0.1:5192,http://localhost:5192,http://127.0.0.1:5193,http://localhost:5193,http://127.0.0.1:5194,http://localhost:5194
# Built React apps (npm run build:apps) served by the API; empty = API only.
WEB_DIR=web/apps
# Swagger UI at /api/docs (spec: make openapi). Off by default; keep it off in production.
API_DOCS=true
# Uploaded documents: local (DOCUMENTS_DIR) for development, s3 in production.
FILE_STORAGE=local
DOCUMENTS_DIR=var/documents
# FILE_STORAGE=s3 settings (credentials from the standard AWS chain):
# S3_BUCKET=justixauto-documents
# S3_REGION=eu-central-1
# S3_PREFIX=documents/
# S3_SSE=AES256
# For MinIO or another S3-compatible store:
# S3_ENDPOINT=http://127.0.0.1:59000
# S3_FORCE_PATH_STYLE=true
# Kubernetes / observability (see ADR-15). Probes: /healthz (process), /readyz (database).
# SHUTDOWN_DRAIN=5s                       # keep serving after SIGTERM while endpoints update
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # enables OTLP traces and metrics
# OTEL_SERVICE_NAME=justixauto-api
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
